# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinelstream
DATABASE_URL=postgresql://sentinel:sentinel_secret@postgres:5432/sentinelstream

# ─── Backend (Bun + Hono) ─────────────────────────────────────
PORT=3000
JWT_SECRET=change_me_to_a_long_random_string_in_production

# URL the backend uses to talk to the worker
WORKER_URL=http://worker:8001

# ─── Worker (Python) ──────────────────────────────────────────
WORKER_PORT=8001

# URL the worker uses to post alerts back to the backend
API_URL=http://backend:3000

# Secret so the worker can call internal-only API routes
WORKER_SECRET=internal_worker_secret

# ─── Frontend (React) ─────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
